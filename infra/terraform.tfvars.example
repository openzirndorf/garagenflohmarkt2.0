# Kopieren nach terraform.tfvars und ausfüllen (wird NICHT eingecheckt)
#
# Hinweis: Die SMTP-Variablen können alternativ direkt im Scaleway-Webinterface gesetzt werden:
#   Serverless Containers → flohmarkt-api → Environment Variables
# Das ist einfacher, wenn du keinen lokalen tofu apply machen willst.

scw_access_key      = "<Scaleway Access Key>"
scw_secret_key      = "<Scaleway Secret Key>"
scw_project_id      = "<Scaleway Project ID für die App-Ressourcen>"
# Projekt, in dem Transactional Email/die Absenderdomain verifiziert ist -
# kann dasselbe wie scw_project_id sein, muss aber nicht.
smtp_project_id     = "<Scaleway Project ID für Transactional Email>"
db_password         = "<openssl rand -base64 32>"
admin_token         = "<openssl rand -base64 32>"
api_username        = "flohmarkt"
api_password        = "<openssl rand -base64 32>"
container_image_tag = "latest"
# database_url wird automatisch aus scaleway_rdb_instance.flohmarkt + db_password abgeleitet

# SMTP – Scaleway Transactional Email, wird automatisch aus main.tf gesetzt:
#   SMTP_HOST     = smtp.tem.scaleway.com  (hardcoded)
#   SMTP_PORT     = 465                    (hardcoded, SSL)
#   SMTP_USER     = smtp_project_id        (hardcoded)
#   SMTP_PASSWORD = scw_secret_key         (hardcoded)
smtp_from     = "noreply@automail.DEINE_DOMAIN.de"  # Absenderadresse, muss in Scaleway TEM verifiziert sein

# Öffentliche Backend-URL (für Bestätigungslinks in E-Mails)
# Beim ersten Deploy leer lassen (""), nach Apply mit Container-URL befüllen
backend_url   = "https://api.DEINE_DOMAIN.de"
# Läuft im selben Container wie das Backend (siehe
# scaleway_container_domain.flohmarkt_frontend in main.tf) - kein
# separates Frontend-Hosting mehr nötig.
frontend_url  = "https://DEINE_FRONTEND_DOMAIN.de"

# Kostenloser Account unter https://opencagedata.com - ohne diesen Key fällt
# app/geocode.py auf die öffentliche Nominatim-Instanz zurück, was gegen
# deren Nutzungsbedingungen verstößt (siehe app/geocode.py). Vor dem
# ersten echten Produktivbetrieb setzen.
geocode_api_key = "<OpenCage Access Token>"

# Datum für die Platzhalter-/Countdown-Seite (GET /launch-config) - leer
# lassen, solange noch nicht feststeht, wann die App öffentlich sichtbar
# werden soll (siehe app/main.py, frontend/src/components/coming-soon.tsx).
launch_at = ""
